# Application
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# PostgreSQL
POSTGRES_USER=autonoma
POSTGRES_PASSWORD=autonoma_dev_pw
POSTGRES_DB=autonoma
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# MLflow
MLFLOW_TRACKING_URI=http://mlflow:5000

# Groq (AI agent LLM backend)
# Get from https://console.groq.com/keys
GROQ_API_KEY=

# Replay & evaluation
DATASET=elec2
LABEL_DELAY_RECORDS=50
